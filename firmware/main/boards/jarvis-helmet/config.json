{
    "type": "jarvis-helmet",
    "target": "esp32s3",
    "builds": [
        {
            "name": "jarvis-helmet",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/jarvis-helmet/partitions_jarvis_16m.csv\"",
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_OTA_URL=\"http://192.168.1.27:8003/xiaozhi/ota/\""
            ]
        },
        {
            "name": "jarvis-helmet-7pin",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240_7PIN=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/jarvis-helmet/partitions_jarvis_16m.csv\"",
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_OTA_URL=\"http://192.168.1.27:8003/xiaozhi/ota/\""
            ]
        },
        {
            "name": "jarvis-helmet-multinet",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/jarvis-helmet/partitions_jarvis_16m.csv\"",
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"jia wei si;guan jia\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"Jarvis;Quản gia\"",
                "CONFIG_OTA_URL=\"http://192.168.1.27:8003/xiaozhi/ota/\""
            ]
        },
        {
            "name": "jarvis-helmet-mww",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/jarvis-helmet/partitions_jarvis_16m.csv\"",
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_JARVIS_MICRO_WAKE_WORD=y",
                "CONFIG_JARVIS_MWW_CUTOFF_PCT=97",
                "CONFIG_JARVIS_MWW_SLIDING_WINDOW=5",
                "CONFIG_OTA_URL=\"http://192.168.1.27:8003/xiaozhi/ota/\""
            ]
        }
    ]
}
