# Files that run or are parsed on Linux (server host, containers, ESP-IDF image) must keep LF
# endings even when checked out on Windows with core.autocrlf=true.
*.sh            text eol=lf
*.py            text eol=lf
*.tmpl          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.dockerignore  text eol=lf
.dockerignore   text eol=lf
.env.example    text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
*.csv           text eol=lf
*.toml          text eol=lf
*.cfg           text eol=lf
*.conf          text eol=lf
*.ini           text eol=lf
.shellcheckrc   text eol=lf
