# =============================================================================================
# Jarvis Helmet – biến môi trường cho docker compose (server/).
#
#   cp .env.example .env && chmod 600 .env     # rồi sửa các giá trị "change-me"
#
# - File .env KHÔNG được commit (đã có trong .gitignore). Chỉ commit file mẫu này.
# - Docker Compose đọc file này để thay ${BIẾN} trong docker-compose.yml. Mỗi container chỉ nhận
#   đúng các biến được liệt kê cho nó trong docker-compose.yml (khóa Anthropic chỉ vào litellm,
#   TUNNEL_TOKEN chỉ vào cloudflared...). Thêm một biến mới vào đây thì cũng phải thêm nó vào
#   phần environment của service tương ứng (server/scripts/tests kiểm tra việc này).
# - KHÔNG đặt token API của Cloudflare (CF_API_TOKEN…) vào đây: xem cloudflared/README.md.
# - Giá trị không cần dấu nháy, được phép có dấu cách. Tránh ký tự "$" (Compose sẽ thay biến).
# - Sinh khóa ngẫu nhiên:  openssl rand -hex 32
# =============================================================================================

# ---- Chung ------------------------------------------------------------------------------------
# Múi giờ của mọi container (giờ trong log, {{current_time}} trong prompt của xiaozhi).
TZ=Asia/Ho_Chi_Minh
# IP LAN của máy server (nên đặt DHCP reservation trên router để IP không đổi).
LAN_IP=192.168.1.27

# ---- xiaozhi-server (cổng mở ra LAN) ----------------------------------------------------------
# Cổng WebSocket trên máy host (cổng 8000 của host đã bị dự án khác dùng) -> container 8000.
XIAOZHI_WS_PORT=8100
# Cổng OTA trên máy host -> container 8003.
XIAOZHI_OTA_PORT=8003
# (Tùy chọn) Chỉ mở 2 cổng trên đúng một card mạng, ví dụ IP LAN. Mặc định 0.0.0.0 = mọi card.
# Nên đặt bằng LAN_IP sau khi IP đã cố định: cổng Docker publish đi vòng qua ufw.
# XIAOZHI_BIND_IP=192.168.1.27
# Địa chỉ WebSocket mà OTA trả cho mũ. Ở nhà (LAN):
PUBLIC_WS_URL=ws://192.168.1.27:8100/xiaozhi/v1/
# Khi dùng Cloudflare Tunnel (giai đoạn P8) đổi thành:
# PUBLIC_WS_URL=wss://jarvis.<domain>/xiaozhi/v1/
# Địa chỉ OTA (firmware CONFIG_OTA_URL). Qua tunnel: https://jarvis.<domain>/xiaozhi/ota/
PUBLIC_OTA_URL=http://192.168.1.27:8003/xiaozhi/ota/
# (Tùy chọn) Địa chỉ vision/tải firmware; mặc định suy ra từ PUBLIC_OTA_URL
# (…/xiaozhi/ota/ -> …/mcp/vision/explain). Phải cùng host:cổng với OTA.
# PUBLIC_VISION_URL=http://192.168.1.27:8003/mcp/vision/explain
# (Tùy chọn) Mức log của xiaozhi: INFO (mặc định) | DEBUG | WARNING | ERROR.
# XIAOZHI_LOG_LEVEL=INFO
# Khóa HMAC ký token WebSocket của xiaozhi (server.auth_key). Phải cố định: đổi khóa là mọi
# token đã cấp mất hiệu lực cho đến khi mũ khởi động lại. Sinh bằng: openssl rand -hex 32
XIAOZHI_AUTH_KEY=change-me-long-random

# ---- LiteLLM (định tuyến LLM) ----------------------------------------------------------------
# Khóa chủ của LiteLLM; xiaozhi và plugin ask_expert dùng khóa này. Bắt buộc, phải mạnh,
# bắt đầu bằng "sk-" (LiteLLM v1.104.0 từ chối khởi động nếu trống hoặc là sk-1234).
# Sinh bằng: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-change-me-long-random
# Khóa API cloud. Chỉ cần khóa của nhà cung cấp đang dùng cho jarvis-cloud.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model cloud cho jarvis-cloud (dự phòng khi local lỗi + plugin ask_expert), dạng LiteLLM
# "<nhà cung cấp>/<model id>". Đổi model thì sửa cả giá trong litellm/config.yaml (README.md).
CLOUD_MODEL=anthropic/claude-opus-5-5
# Ngân sách tối đa mỗi tháng (USD) cho jarvis-cloud. Vượt ngân sách -> LiteLLM trả 429,
# không gọi cloud nữa đến kỳ sau. Phải là số > 0: LiteLLM hiểu 0 là "không giới hạn" nên
# litellm sẽ từ chối khởi động với 0. Muốn chặn hẳn cloud: để trống ANTHROPIC_API_KEY.
CLOUD_MONTHLY_BUDGET_USD=10
# (Tùy chọn) Mức log của LiteLLM: DEBUG | INFO | WARNING | ERROR.
# LITELLM_LOG=INFO
# (Tùy chọn) max_tokens tối thiểu cho lượt gọi cloud (Claude 5.5 luôn "nghĩ", token nghĩ tính vào
# max_tokens; xiaozhi chỉ xin 300). 0 = tắt. Mặc định 1024.
# JARVIS_CLOUD_MIN_MAX_TOKENS=1024

# ---- Ollama (LLM local) -----------------------------------------------------------------------
# Model local (tag Ollama). Mặc định: Qwen3 30B-A3B instruct 2507, lượng tử Q4_K_M (19 GB).
# Phương án khác: gemma4:26b-a4b-it-qat (16 GB), qwen3.6:35b-a3b-q4_K_M (24 GB, chỉ khi đủ VRAM).
# Đổi xong: scripts/pull_models.sh rồi docker compose up -d litellm.
OLLAMA_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# (Tùy chọn) Ghi đè thông số Ollama (mặc định trong docker-compose.yml):
# OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=f16
# (Tùy chọn) Dùng Ollama khác thay cho container ollama (mặc định http://ollama:11434).
# OLLAMA_API_BASE=http://ollama:11434

# ---- ASR (nhận dạng giọng nói) ---------------------------------------------------------------
# Engine: faster_whisper (mặc định) | qwen3_vllm (cần profile asr-qwen).
ASR_ENGINE=faster_whisper
# Model: large-v3 | large-v3-turbo | id HuggingFace (ví dụ bản CT2 của PhoWhisper).
ASR_MODEL=large-v3
# Revision (commit) HuggingFace ghim cho model trên; để trống nếu đổi model.
ASR_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
# Ngôn ngữ: vi | en | auto (tự nhận).
ASR_LANGUAGE=vi
# Câu mồi từ vựng giúp Whisper viết đúng tên riêng và lệnh trộn Việt–Anh.
ASR_INITIAL_PROMPT=Jarvis, quản gia, mở mặt nạ, đóng mặt nạ, bật đèn mắt, tắt đèn mắt, open mask, close mask, combat mode, stealth mode.
# Kiểu tính: float16 (GPU) | int8_float16 (GPU, ít VRAM hơn) | int8 (CPU).
ASR_COMPUTE_TYPE=float16
# Thiết bị: cuda | cpu.
ASR_DEVICE=cuda
# Lưu dữ liệu thử ASR (wav + jsonl). Để trống = tắt. Bật: ASR_SAVE_DIR=/data/asr-dataset
# (thư mục này nằm trong volume asr_dataset).
ASR_SAVE_DIR=
# (Tùy chọn, mặc định trong service ASR):
# ASR_BEAM_SIZE=5
# ASR_WARMUP=1
# ASR_HALLUCINATIONS_FILE=
# ASR_VLLM_URL=http://asr-qwen:8000

# ---- TTS (tổng hợp giọng nói) ----------------------------------------------------------------
# Giọng VieNeu mặc định (giọng nam). Tên phải viết đúng dấu (Unicode NFC). Các giọng nam khác:
# Hải Đăng, Thiện Minh, Thanh Bình, Minh Đức, Phạm Tuyên. Nghe thử: tools/tests/tts/bench.py
# (lưu file wav cho từng giọng) và server/tts/README.md.
TTS_VOICE=Thiền Tâm Đức
# Engine cho câu thuần tiếng Anh: vieneu (mặc định) | kokoro (cần profile english-tts).
TTS_ENGLISH_ENGINE=vieneu
# (Tùy chọn) Giọng Kokoro cho câu tiếng Anh (profile english-tts), dùng cho cả router và Kokoro.
# TTS_ENGLISH_VOICE=bm_george
# (Tùy chọn) Số luồng VieNeu.
# VIENEU_MAX_STREAMS=4
# (Tùy chọn) Chế độ offline của VieNeu: auto (mặc định) = tự offline khi model và codec đã có
# trong cache (VieNeu chạy code từ Hugging Face không ghim phiên bản); 1 = luôn offline;
# 0 = luôn online (chỉ khi cần tải model mới).
# TTS_HF_OFFLINE=auto

# ---- Truy cập từ xa (Cloudflare Tunnel, profile tunnel) ---------------------------------------
# Token của tunnel do Cloudflare quản lý (bắt đầu bằng "eyJ"). Để trống nếu chưa dùng tunnel.
# Hướng dẫn đầy đủ (Access, route, nạp token vào mũ): cloudflared/README.md
TUNNEL_TOKEN=
# (Tùy chọn) Profile compose luôn bật, cách nhau bằng dấu phẩy: tunnel, english-tts, asr-qwen.
# COMPOSE_PROFILES=tunnel

# ---- HuggingFace ------------------------------------------------------------------------------
# Token HF (chỉ cần với model bị giới hạn truy cập; các model mặc định đều công khai).
HF_TOKEN=

# ---- Dashboard (tùy chọn, profile dashboard) ----------------------------------------------------
# Trang trạng thái http://<LAN_IP>:8090: mũ (mic, loa, Wi-Fi, mặt nạ...), các service, hội thoại gần
# đây và độ trễ. Bật: COMPOSE_PROFILES=dashboard (hoặc deploy.sh --profiles dashboard). Trang hiện
# những gì mũ nghe được: bắt buộc có mật khẩu (đăng nhập user DASHBOARD_USER, mặc định jarvis).
# DASHBOARD_PASSWORD=
# DASHBOARD_USER=jarvis
# DASHBOARD_PORT=8090
# DASHBOARD_BIND_IP=192.168.1.27
# IP của mũ để hỏi trạng thái ngay cả khi chưa nói chuyện lần nào (cách nhau dấu phẩy); token MCP
# cục bộ nếu đã nạp vào mũ (tools/provision_secrets.py --mcp-token).
# JARVIS_DEVICE_HOSTS=192.168.1.28
# JARVIS_MCP_TOKEN=

# ---- Khác (tùy chọn) --------------------------------------------------------------------------
# Tag cho các image tự build (jarvis/xiaozhi, jarvis/asr, ...). Mặc định: dev
# JARVIS_IMAGE_TAG=dev
# Cổng 127.0.0.1 khi dùng docker-compose.debug.yml.
# DEBUG_ASR_PORT=9000
# DEBUG_LITELLM_PORT=4000
# DEBUG_TTS_PORT=8880
# Ghi log cả các lượt gọi LLM local (mặc định chỉ log cloud, lỗi và fallback).
# JARVIS_LOG_LOCAL_CALLS=0

# ---- Chỉ dùng với docker-compose.local.yml (máy dev, Docker Desktop) ---------------------------
# LOCAL_OLLAMA_BASE=http://host.docker.internal:11434
# LOCAL_OLLAMA_MODEL=qwen3:4b-instruct
# LOCAL_MAIN_API_BASE=http://127.0.0.1:9        # địa chỉ chết: thử chuyển sang cloud
# LOCAL_ASR_MODEL=small
# LOCAL_ASR_COMPUTE_TYPE=int8_float16
# LOCAL_ASR_DEVICE=cuda
# LOCAL_VIENEU_DEVICE=auto
